<%- include('../partials/header', { title: 'Browse', description: 'Search lost and found items reported on campus.' }) %>
<% const filtered = filters.q || filters.category || filters.kind; %>
<div class="stack">
  <div class="page-head">
    <div>
      <h1>Lost &amp; Found Board</h1>
      <p class="muted">Lost something on campus, or found something that isn't yours? Start here.</p>
    </div>
    <div class="stat" aria-label="<%= pagination.total %> items">
      <strong><%= pagination.total %></strong>
      <span class="muted small"><%= filtered ? 'matching' : 'total' %> item<%= pagination.total === 1 ? '' : 's' %></span>
    </div>
  </div>

  <div class="toolbar">
    <form class="toolbar-form" action="/items" method="get" role="search" data-autosubmit>
      <div class="search input-icon">
        <%- icon('search') %>
        <label for="q" class="sr-only">Search by keyword</label>
        <input id="q" class="input" name="q" type="search" value="<%= filters.q %>" placeholder="Search titles and descriptions" autocomplete="off">
      </div>
      <label for="category" class="sr-only">Category</label>
      <select id="category" class="select" name="category">
        <option value="">All categories</option>
        <% categories.forEach(c => { %><option value="<%= c.id %>" <%= filters.category === String(c.id) ? 'selected' : '' %>><%= c.name %></option><% }) %>
      </select>
      <fieldset class="segmented" style="border:0;margin:0">
        <legend class="sr-only">Type</legend>
        <label><input type="radio" name="kind" value="" <%= !filters.kind ? 'checked' : '' %>><span>All</span></label>
        <label><input type="radio" name="kind" value="lost" <%= filters.kind === 'lost' ? 'checked' : '' %>><span>Lost</span></label>
        <label><input type="radio" name="kind" value="found" <%= filters.kind === 'found' ? 'checked' : '' %>><span>Found</span></label>
      </fieldset>
      <button type="submit" class="btn js-hide"><%- icon('search') %>Search</button>
      <% if (filtered) { %>
        <a class="btn btn-ghost" href="/items"><%- icon('reset') %>Reset</a>
      <% } %>
    </form>
  </div>

  <% if (!items.length) { %>
    <div class="card empty">
      <span class="empty-icon"><%- icon('search-x') %></span>
      <h2>No items match your search</h2>
      <p class="muted">Try a different keyword, pick another category, or clear the filters to see everything on the board.</p>
      <% if (filtered) { %>
        <a class="btn btn-outline" href="/items"><%- icon('reset') %>Clear filters</a>
      <% } else { %>
        <a class="btn" href="/items/new"><%- icon('plus') %>Post the first item</a>
      <% } %>
    </div>
  <% } else { %>
    <div class="results-line">
      <p class="muted" aria-live="polite">Showing <%= pagination.from %>&ndash;<%= pagination.to %> of <%= pagination.total %></p>
      <% if (pagination.totalPages > 1) { %><p class="muted small">Page <%= pagination.page %> of <%= pagination.totalPages %></p><% } %>
    </div>
    <div class="grid-posts">
      <% items.forEach(item => { %><%- include('../partials/card', { item }) %><% }) %>
    </div>
    <%- include('../partials/pagination', { pagination }) %>
  <% } %>
</div>
<%- include('../partials/footer') %>
