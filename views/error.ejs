<% const heading = code === 404 ? "We couldn't find that" : code === 403 ? 'You can’t do that' : 'Something went wrong'; %>
<% const iconName = code === 404 ? 'search-x' : code === 403 ? 'lock' : 'alert'; %>
<%- include('partials/header', { title: heading, description: message }) %>
<div class="card empty error-card">
  <span class="empty-icon"><%- icon(iconName) %></span>
  <span class="code-tag">Error <%= code %></span>
  <h1><%= heading %></h1>
  <p class="muted"><%= message %></p>
  <a class="btn" href="/items"><%- icon('arrow-left') %>Back to the board</a>
</div>
<%- include('partials/footer') %>
